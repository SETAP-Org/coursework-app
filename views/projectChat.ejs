<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <link id="theme-stylesheet" rel="stylesheet"/>
        <link rel="stylesheet" href="/css/project_dash.css" />
        <link rel="stylesheet" href="/css/project_chat.css" />
        <link rel="icon" href="/assets/logo/logo-mark.svg" type="image/svg+xml" />

        <script>
        window.scriptData = {
            userId: "<%= userId %>",
            username: "<%= username %>",
            projectId: "<%= projectId %>",
            projectName: "<%= projectName %>",
            messages: <%- JSON.stringify(messages) %>,
            groupUsers: <%- JSON.stringify(groupUsers) %>,
            isTeamLeader: <%= typeof isTeamLeader !== 'undefined' && isTeamLeader ? 'true' : 'false' %>
        };

</script>
        </script>
        <script src="/scripts/L&D-mode.js" defer type="module"></script>
        <script src="/socket.io/socket.io.js" defer type="module"></script>
        <script type="module" src="/scripts/projectChat.js"></script>

        <title>GCMS | <%= projectName %> Chat</title>
    </head>
    <body>
        <%- include('partials/userNav') %>
        <%- include('partials/projectNav') %>

        <section class="chat-page">
            <h1 id="page-title">Chat</h1>

            <div class="chat-container">
                <div class="chat-messages">
                    <template id="chat-message-template">
                        <div id="message-container">
                            <p id="message-info-top"></p>

                            <div id="message-bubble">
                                <p id="message-content"></p>
                            </div>

                            <p id="message-info-bottom"></p>
                        </div>
                    </template>
                </div>

                <form action="" class="chat-form">
                    <fieldset class="chat-fieldset">
                        <input
                            type="text"
                            placeholder="Write Message Here"
                            class="chat-input"
                            maxlength="30"
                        >
                        <button class="chat-send" disabled>Send</button>
                    </fieldset>
                </form>
            </div>
        </section>

        <%- include('partials/footer') %>

        <%- include('partials/aiAssistant') %>

        <%- include('partials/loading') %>
    </body>
