<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <link rel="stylesheet" href="/css/root-dark.css"/>
        <link rel="stylesheet" href="/css/project_dash.css" />
        <link rel="stylesheet" href="/css/project_chat.css" />
        <link rel="icon" href="/assets/favicon.png" type="image/png" />

        <script src="/scripts/L&D-mode.js" defer></script>
        <script src="/scripts/projectChat.js" defer></script>

        <title>GCMS | <%= project_name %> Chat</title>
    </head>
    <body>
        <%- include('partials/projectNav') %>

        <section class="chat-page">
            <section class="page-header">
                <h1 id="page-title">Chat</h1>
            </section>
            <div class="chat-container">
                <div class="chat-messages">
                    <div class="message-container-left">
                        <div class="message-bubble-left">
                            <p class="message-content-left">This is the message</p>
                        </div>
                        <p class="message-info-left">Sent by Jay</p>
                    </div>

                    <div class="message-container-right">
                        <div class="message-bubble-right">
                            <p class="message-content-right">This is the message</p>
                        </div>
                        <p class="message-info-right">Sent by Jay</p>
                    </div>
                </div>

                <form action="" class="chat-form">
                    <fieldset class="chat-fieldset">
                        <input type="text" name="" id="" placeholder="Write Message Here" class="chat-input">
                        <button class="chat-send" disabled>Send</button>
                    </fieldset>
                </form>
            </div>
        </section>

        <%- include('partials/footer') %>
    </body>
