<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <link rel="stylesheet" href="/css/root-dark.css" />
        <link rel="stylesheet" href="/css/project_dash.css" />
        <link rel="stylesheet" href="/css/Konva.css" />
        <link rel="icon" href="/assets/favicon.png" type="image/png" />

        <script src="/scripts/L&D-mode.js" defer></script>
        <script src="https://unpkg.com/konva@9/konva.min.js" defer></script>
        <script src="/scripts/dash-konva.js" defer></script>

        <title>GCMS | <%= projectName %></title>
    </head>
    <body>
        <%- include('partials/userNav') %>
        <%- include('partials/projectNav') %>

        <div class="Dashboard">
            <main class="Dashboard-content">
                <section class="Dashboard-container">
                    <div class="card">
                        <h1 class="Dashboard-title">Main Content Area</h1>
                        <p class="Dashboard-text">UNI type shit</p>
                    </div>

                    <div class="button_bar"></div>

                    <div class="konva-wrapper">
                        <div id="Konva-container"></div>
                        <div class="delete-zone">Drop Here to Delete</div>
                        <button class="add-note-btn" id="add-note-btn">
                            Add Note
                        </button>
                    </div>
                </section>

                <aside class="Dashboard-right">
                    <section class="card small-box">
                        <h2 class="Dashboard-text">Deadline</h2>
                    </section>

                    <section class="card small-box">
                        <h2 class="Dashboard-text">Calandar</h2>
                    </section>
                </aside>
            </main>

        </div>

        <%- include('partials/footer') %>

        <%- include('partials/loading') %>
    </body>
</html>
