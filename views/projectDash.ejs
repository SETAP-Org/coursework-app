<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <link id="theme-stylesheet" rel="stylesheet"/>
        <link rel="stylesheet" href="/css/project_dash.css" />
        <link rel="stylesheet" href="/css/Konva.css"  />
        <link rel="icon" href="/assets/logo/logo-mark.svg" type="image/svg+xml" />

        <!--Calandar grid-->
        <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet">
        <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>

        <script>
            window.scriptData = {
              userId: "<%= userId %>",
              username: "<%= username %>",
              projectId: "<%= projectId %>",
              projectName: "<%= projectName %>",
              isTeamLeader: <%= typeof isTeamLeader !== 'undefined' && isTeamLeader ? 'true' : 'false' %>,
              notes: <%- JSON.stringify(notes) %>
            };
        </script>
        <script src="/scripts/L&D-mode.js" type="module"></script>
        <script src="https://unpkg.com/konva@9/konva.min.js" type="module"></script>
        <script type="module" src="/scripts/konva-dash.js"></script>
        <script type="module" src="/scripts/loadCalandar.js"></script>

        <title>GCMS | <%= projectName %></title>
    </head>
    <body>
        <%- include('partials/userNav') %>
        <%- include('partials/projectNav') %>

        <div class="Dashboard">
            <main class="Dashboard-content">
                <section class="Dashboard-container">
                    <div class="card">
                        <h1 class="Dashboard-title">Project Note Board</h1>
                        <p class="Dashboard-text"></p>
                    </div>

                    <div class="button_bar"></div>

                    <div class="konva-wrapper">
                        <div id="Konva-container"></div>
                        <div class="delete-zone">Drop Here to Delete</div>
                        <button class="add-note-btn" id="add-note-btn">
                            Add Note
                        </button>
                    </div>
                </section>

                <aside class="Dashboard-right">
                    <section class="deadline-box">
                        <h2>Deadline</h2>
                        <p><%= deadlineLabel %></p>
                    </section>

                    <section class="calendar-box">
                        <div id="calendar"></div>
                    </section>

                    <dialog id="create-meeting-dialog">

                        <form id="meeting-form">
                            <h2>Create Meeting</h2>
                            <label>
                                Title
                                <input type="text" name="meetingSubject" required>
                            </label>
                            <label>
                                Description
                                <textarea name="meetingDescription"></textarea>
                            </label>
                            <label>
                                Start
                                <input type="datetime-local" name="meetingStart" required>
                            </label>
                            <label>
                                End
                                <input type="datetime-local" name="meetingEnd" required>
                            </label>
                            <div class="dialog-buttons">
                                <button type="submit">Create</button>
                                <button type="button" class="modal-close">
                                    Cancel
                                </button>
                            </div>
                        </form>
                    </dialog>
                </main>
            </div>

            <%- include('partials/footer') %>

                <%- include('partials/aiAssistant') %>

                    <%- include('partials/loading') %>
</body>

</html>
