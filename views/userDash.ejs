<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>GCMS | <%= username %></title>

        <link rel="stylesheet" href="/css/user_dash.css"/>
        <link id="theme-stylesheet" rel="stylesheet"/>
        <link rel="icon" href="/assets/logo/logo-mark.svg" type="image/svg+xml" />

        <script>
            window.scriptData = {
                userFirstName: "<%= userFirstName %>",
                username: "<%= username %>",
                userId: "<%= userId %>",
                projects: <%- JSON.stringify(projects) %>
            };
        </script>
        <script src="/scripts/L&D-mode.js" defer type="module"></script>
        <script src="/scripts/userDash.js" defer type="module"></script>
    </head>
    <body>
        <%- include('partials/userNav') %>

        <div class="title">
            <h1>Welcome, <%= userFirstName %></h1>
        </div>

        <template id="project-template">
            <section class="user-dash-project-card-individual">
                <div class="project-info">
                    <b class="project-name"></b>

                    <!-- meta: compact single-line layout with two stacked columns -->
                    <div class="project-meta" aria-hidden="false">
                        <div class="meta-columns">
                            <div class="meta-col">
                                <span class="card-bottom-header">DUE</span>
                                <span class="project-date"></span>
                            </div>
                            <div class="meta-col">
                                <span class="card-bottom-header">Created by</span>
                                <span class="project-creator"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <a href="" class="project-dash-button">Go to project</a>
            </section>
        </template>

        <!-- Empty stuff to be filled in with templates via js -->
        <section class="projects-outer-container">
            <div class="projects-inner-container">
                <ul class="projects-list"></ul>
            </div>
        </section>

        <%- include('partials/footer') %>

        <%- include('partials/loading') %>
    </body>
</html>
