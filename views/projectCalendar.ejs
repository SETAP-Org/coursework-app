<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <link rel="stylesheet" href="/css/root-dark.css"/>
        <link rel="stylesheet" href="/css/project_dash.css" />
        <link rel="stylesheet" href="/css/calandar.css" />
        <link rel="icon" href="/assets/logo/logo-mark.svg" type="image/svg+xml" />

        <script src="/scripts/L&D-mode.js" defer></script>
        <script>
            window.scriptData = {
                projectId: "<%= projectId %>"
            };
        </script>

        <title>GCMS | <%= projectName %> Calendar</title>
    </head>
    <body>
        <%- include('partials/userNav') %>
    <%- include('partials/projectNav') %>

        <!-- Create Event Form -->
        <div class="event-form">
            <h2>Add Event</h2>
            <form id="event-form">
                <label for="event-subject">Subject</label>
                <input type="text" id="event-subject" required placeholder="Meeting title">

                <label for="event-start">Start</label>
                <input type="datetime-local" id="event-start" required>

                <label for="event-end">End</label>
                <input type="datetime-local" id="event-end" required>

                <label for="event-description">Description</label>
                <textarea id="event-description" rows="3" placeholder="Optional description"></textarea>

                <button type="submit" >Create Event</button>
            </form>
        </div>

        <!-- Events List -->
        <h2>Your Events</h2>
        <div id="events-list">
            <p>Loading events...</p>
        </div>


        <%- include('partials/footer') %>

        <%- include('partials/loading') %>
    </body>

    <script src="/scripts/calendar.js"></script>
