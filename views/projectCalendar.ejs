<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <link id="theme-stylesheet" rel="stylesheet"/>
        <link rel="stylesheet" href="/css/project_dash.css" />
        <link rel="stylesheet" href="/css/project_calandar.css" />
        <link rel="icon" href="/assets/logo/logo-mark.svg" type="image/svg+xml" />

        <script>
            window.scriptData = {
                userId: "<%= userId %>",
                username: "<%= username %>",
                projectId: "<%= projectId %>",
                projectName: "<%= projectName %>",
                isTeamLeader: <%= typeof isTeamLeader !== 'undefined' && isTeamLeader ? 'true' : 'false' %>,
                meetings: <%- JSON.stringify(meetings) %>,
                groupUsers: <%- JSON.stringify(groupUsers) %>,
            };
        </script>
        <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.20/index.global.min.js'></script>
        <script src="/scripts/L&D-mode.js" defer type="module"></script>
        <script src="/socket.io/socket.io.js" defer type="module"></script>
        <script src="/scripts/projectCalendar.js" type="module"></script>

        <title>GCMS | <%= projectName %> Calendar</title>
    </head>
    <body>
        <%- include('partials/userNav') %>
        <%- include('partials/projectNav') %>

        <section id="page-content">
            <section class="page-header">
                <h1 id="page-title">Meetings</h1>
                <button id="create-meeting-button">New Meeting</button>
            </section>

            <div id="calendar-large"></div>
        </section>

        <!-- Create Meeting Popup -->
        <dialog id="create-meeting-dialog">
            <button class="modal-close">
                X
            </button>
            <form method="dialog">
                <h1>Create Meeting</h1>
                <label>
                    Subject
                    <input type="text" placeholder="e.g. Group Meeting" name="meetingSubject" required />
                </label>
                <label>
                    Description
                    <input type="text" placeholder="e.g. This is a meeting" name="meetingDescription" required />
                </label>
                <label>
                    Start
                    <input type="datetime-local" name="meetingStart" required />
                </label>
                <label>
                    End
                    <input type="datetime-local" name="meetingEnd" required />
                </label>
                <button type="submit">Create Meeting</button>
            </form>
        </dialog>

        <%- include('partials/footer') %>

        <%- include('partials/aiAssistant') %>

        <%- include('partials/loading') %>
    </body>
</html>
