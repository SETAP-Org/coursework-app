<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <link id="theme-stylesheet" rel="stylesheet"/>
        <link rel="stylesheet" href="/css/project_dash.css" />
        <link rel="stylesheet" href="/css/calandar.css" />
        <link rel="icon" href="/assets/logo/logo-mark.svg" type="image/svg+xml" />

        <script>
          window.scriptData = {
              userId: "<%= userId %>",
              username: "<%= username %>",
              projectId: "<%= projectId %>",
              projectName: "<%= projectName %>",
              events: <%- JSON.stringify(events) %>,
              isTeamLeader: <%= typeof isTeamLeader !== 'undefined' && isTeamLeader ? 'true' : 'false' %>
          };
        </script>
        <script src="/scripts/L&D-mode.js" defer type="module"></script>
        <script src="/scripts/projectCalendar.js" type="module"></script>

        <title>GCMS | <%= projectName %> Calendar</title>
    </head>
    <body>
        <%- include('partials/userNav') %>
        <%- include('partials/projectNav') %>

        <!-- Create Event Form -->
        <!--<div class="event-form">
            <h2>Add Event</h2>
            <form id="event-form">
                <label for="event-form-subject">Subject</label>
                <input type="text" id="event-form-subject" required placeholder="Meeting title">

                <label for="event-form-start">Start</label>
                <input type="datetime-local" id="event-form-start" required>

                <label for="event-form-end">End</label>
                <input type="datetime-local" id="event-form-end" required>

                <label for="event-form-description">Description</label>
                <textarea id="event-form-description" rows="3" placeholder="Optional description"></textarea>

                <button type="submit" >Create Event</button>
            </form>
        </div>-->

        <button id="create-meeting-button">New Meeting</button>

        <!-- Create Meeting Popup -->
        <dialog id="create-meeting-dialog">
            <button class="modal-close" onclick="toggleNewTaskForm()">
                X
            </button>
            <form method="dialog">
                <h1>Create Meeting</h1>
                <label>
                    Subject
                    <input type="text" placeholder="e.g. Group Meeting" name="meetingSubject" required />
                </label>
                <label>
                    Description
                    <input type="text" placeholder="e.g. This is a meeting" name="meetingDescription" required />
                </label>
                <label>
                    Start
                    <input type="datetime-local" name="meetingStart" required />
                </label>
                <label>
                    End
                    <input type="datetime-local" name="meetingEnd" required />
                </label>
                <button type="submit">Create Meeting</button>
            </form>
        </dialog>

        <!-- Events List -->
        <h2>Your Events</h2>
        <div id="events-list">
            <template class="event-template">
                <div class="event-card">
                    <h3 class="event-heading"></h3>
                    <p class="event-start"></p>
                    <p class="event-end"></p>
                    <p class="event-description"></p>
                    <button class="event-delete-button">Delete</button>
                </div>
            </template>
        </div>

        <%- include('partials/footer') %>

        <%- include('partials/aiAssistant') %>

        <%- include('partials/loading') %>
    </body>
</html>
