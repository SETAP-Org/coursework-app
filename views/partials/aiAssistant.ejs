<link rel="stylesheet" href="/css/ai_assistant.css" />
<script src="/scripts/aiAssistant.js" defer></script>

<div id="ai-assistant" class="ai-assistant ai-assistant--collapsed" aria-live="polite">
    <!-- Collapsed launcher button -->
    <button
        id="ai-assistant-launcher"
        class="ai-assistant__launcher"
        type="button"
        aria-label="Open AI Assistant"
        title="Ask the AI Assistant"
    >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2 L13.5 8.5 L20 10 L13.5 11.5 L12 18 L10.5 11.5 L4 10 L10.5 8.5 Z" />
            <path d="M19 4 L19.6 6 L21.5 6.5 L19.6 7 L19 9 L18.4 7 L16.5 6.5 L18.4 6 Z" />
        </svg>
        <span>AI Assistant</span>
    </button>

    <!-- Expanded chat panel -->
    <section id="ai-assistant-panel" class="ai-assistant__panel" hidden>
        <header class="ai-assistant__header">
            <div class="ai-assistant__title">
                <span class="ai-assistant__title-main">GCMS Assistant</span>
                <span class="ai-assistant__title-sub">Ask about your project files</span>
            </div>
            <div class="ai-assistant__header-actions">
                <button
                    id="ai-assistant-clear"
                    class="ai-assistant__icon-btn"
                    type="button"
                    title="Clear conversation (team leader only)"
                    aria-label="Clear conversation"
                >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="3 6 5 6 21 6" />
                        <path d="m19 6-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                        <path d="M10 11v6" />
                        <path d="M14 11v6" />
                    </svg>
                </button>
                <button
                    id="ai-assistant-close"
                    class="ai-assistant__icon-btn"
                    type="button"
                    title="Close"
                    aria-label="Close AI Assistant"
                >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
            </div>
        </header>

        <div id="ai-assistant-messages" class="ai-assistant__messages" aria-live="polite"></div>

        <form id="ai-assistant-form" class="ai-assistant__form" autocomplete="off">
            <fieldset class="ai-assistant__fieldset">
                <textarea
                    id="ai-assistant-input"
                    class="ai-assistant__input"
                    placeholder="Ask about the spec, summarise a file, etc."
                    rows="1"
                    aria-label="Message"
                ></textarea>
                <button
                    id="ai-assistant-send"
                    class="ai-assistant__send"
                    type="submit"
                    disabled
                    aria-label="Send"
                >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="22" y1="2" x2="11" y2="13" />
                        <polygon points="22 2 15 22 11 13 2 9 22 2" />
                    </svg>
                </button>
            </fieldset>
        </form>
    </section>
</div>