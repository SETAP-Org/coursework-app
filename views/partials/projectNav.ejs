<link rel="stylesheet" href="/css/header_style.css">
<script src="/scripts/nav.js" defer></script>

<nav class="Dashboard-header" id="MyHeader">
    <div class="card nav-links">
        <a class="nav-icon" id="projects-button">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
            </svg>
        </a>
    </div>

    <div class="card logo-card">
        <h2>
            <%= project_name %>
        </h2>
    </div>

    <div class="card nav-links">
        <button class="nav-icon" id="project-burger">
            <svg width="20" height="14" viewBox="0 0 20 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect y="0" width="20" height="2" rx="1" fill="currentColor"></rect>
            <rect y="6" width="20" height="2" rx="1" fill="currentColor"></rect>
            <rect y="12" width="20" height="2" rx="1" fill="currentColor"></rect>
            </svg>
        </button>
    </div>
</nav>
