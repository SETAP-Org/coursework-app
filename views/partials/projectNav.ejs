<link rel="stylesheet" href="/css/header_style.css">
<script src="/scripts/nav.js" defer></script>

<nav class="Dashboard-header project-header" id="MyHeader">
    <div class="card nav-links">
        <a class="Dashboard-text Dashboard-links" id="projects-button">All Projects</a>
    </div>

    <div class="card logo-card">
        <a id="nav-project-name" href="/<%= username %>/projects/<%= projectId %>">
            <%= projectName %>
        </a>
    </div>

    <div>
        <input type="checkbox" id="check">
        <label for="check" class="checkbtn">
            <svg width="20" height="14" viewBox="0 0 20 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect y="0" width="20" height="2" rx="1" fill="currentColor"></rect>
            <rect y="6" width="20" height="2" rx="1" fill="currentColor"></rect>
            <rect y="12" width="20" height="2" rx="1" fill="currentColor"></rect>
            </svg>
        </label>
        <div class="nav-mobile">
            <a href="/<%= username %>/projects/<%= projectId %>/information">Information</a>
            <a href="/<%= username %>/projects/<%= projectId %>/tasks">Tasks</a>
            <a href="/<%= username %>/projects/<%= projectId %>/calendar">Calendar</a>
            <a href="/<%= username %>/projects/<%= projectId %>/chat">Chat</a>
            <a href="/<%= username %>/projects/<%= projectId %>/contributions">Contributions</a>
            <a href="/<%= username %>/projects/<%= projectId %>/files">Files</a>
        </div>
    </div>
</nav>
