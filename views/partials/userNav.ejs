<link rel="stylesheet" href="/css/header_style.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer"/>

<script src="/socket.io/socket.io.js" defer type="module"></script>
<script src="/scripts/userNav.js" defer type="module"></script>

<nav class="Dashboard-header" id="MyHeader">
    <div class="card logo-card">
        <h2 class="Dashboard-text">
            <a class="Dashboard-links" id="home-button">Home</a>
        </h2>
    </div>

    <div class="card nav-links">
        <div class="notif-bell">
            <i class="fa fa-bell bell-icon"></i>
            <div id="notif-bell-num-bubble">
                <span id="notif-bell-num"></span>
            </div>
        </div>
        <a class="Dashboard-text Dashboard-links" id="projects-button">Projects</a>
        <button class="profile-nav-button" id="profile-button" type="button" aria-label="Open profile">
            <img class="profile-nav-avatar" src="/api/me/photo" alt="Your profile picture" onerror="this.onerror=null;this.src='/assets/default-avatar.svg';">
        </button>
    </div>

    <%- include('../partials/notifications') %>

<!-- <button class="nav-burger">&#9776;</button> -->
</nav>
