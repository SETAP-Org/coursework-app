<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <link rel="stylesheet" href="/css/landing.css">
        <link id="theme-stylesheet" rel="stylesheet" href="/css/root-dark.css" />
        <link rel="icon" href="/assets/logo/logo-mark.svg" type="image/svg+xml">

        <script src="/scripts/L&D-mode.js" defer></script>

        <title>GCMS | Landing Page</title>
    </head>
    <body class="landing-page">
        <%- include("partials/landingNav") %>

        <section id="content-body">
            <img id="landing-image" src="/assets/landing-page-students.png" alt="Landing Image">
            <div id="landing-text">
                <h1 id="strapline">Working as a group has never been easier.</h1>
                <h2>Welcome to GCMS</h2>
                <p>
                    GCMS is a group coursework management system designed to make group projects easier to manage
                    for students. With GCMS, you can easily create and manage group projects, assign tasks, and
                    track progress all in one place.
                </p>
                <a href="api/auth" class="ms-sign-in"><img id="ms-logo" src="/assets/ms-logo.png" />Sign In With Microsoft</a>
            </div>
        </section>

        <%- include('partials/footer') %>

        <% if (!cookieConsent) { %>
            <%- include('partials/cookieBanner') %>
        <% } %>

        <%- include('partials/loading') %>
    </body>
</html>
