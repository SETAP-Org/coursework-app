<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <link rel="stylesheet" href="/css/root-dark.css"/>
        <link rel="stylesheet" href="/css/project_dash.css" />
        <link rel="stylesheet" href="/css/project_info.css">
        <link rel="icon" href="/assets/favicon.png" type="image/png"/>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer"/>

        <script>
            window.scriptData = {
                userId: "<%= userId %>",
                username: "<%= username %>",
                projectId: "<%= projectId %>",
                projectName: "<%= projectName %>",
                creatorId: "<%= creatorId %>",
                teamLeaderId: "<%= teamLeaderId %>",
                projectDeadline: "<%= projectDeadline %>",
                projectMembers: <%- JSON.stringify(projectMembers) %>,
            };
        </script>
        <script src="/socket.io/socket.io.js"></script>
        <script src="/scripts/L&D-mode.js" defer></script>
        <script src="/scripts/projectInfo.js" defer></script>

        <title>GCMS | <%= projectName %> Information</title>
    </head>
    <body>
        <%- include('partials/projectNav') %>

        <section class="page-container">
            <h1 class="project-heading"><%= projectName %></h1>

            <!-- information -->
            <h2 class="project-sub-heading">Information</h2>
    
            <section class="section-outer-container">
                <div class="section-inner-container">
                    <div class="info-section-card">
                        <h2 class="info-section-heading">Project Name</h2>
                        <p><%= projectName %></p>
                    </div>

                    <div class="info-section-card">
                        <h2 class="info-section-heading">Project Description</h2>
                        <p>Lorem ipsum dolor sit amet consectetur, adipisicing elit. Quos, dicta. Neque ipsam tempora, id harum dolor reprehenderit aperiam asperiores. Rem, mollitia recusandae temporibus at sunt incidunt! Voluptates nobis rerum minima?</p>
                    </div>
    

                    <div class="info-section-card">
                        <h2 class="info-section-heading">Project Deadline</h2>
                        <p>Insert formatted deadline here...</p>
                    </div>
    

                    <div class="info-section-card">
                        <h2 class="info-section-heading">Team Leader</h2>
                        <p class="info-section-team-leader"></p>
                    </div>
    

                    <div class="info-section-card">
                        <h2 class="info-section-heading">Project Members</h2>
                        <ul class="info-section-list">
                            <template class="info-section-li-template">
                                <li class="info-section-li">
                                    <i class="fa fa-user"></i>
                                    <p class="info-section-li-text"></p>
                                </li>
                            </template>
                        </ul>
                    </div>
    
                </div>
            </section>
    
            <!-- settings -->
            <h2 class="project-sub-heading">Settings</h2>

            <section class="section-outer-container">
                <div class="section-inner-container">
                    <!-- leave group -->
                    <div class="settings-section-card">
                        <h2 class="settings-section-header">Want to leave the project?</h2>
                        <button class="settings-section-button" id="leave-button">Click Me!</button>
                    </div>
                    
                    <% if (userId == teamLeaderId) { %>
                        <!-- add members -->
                        <div class="settings-section-card">
                            <h2 class="settings-section-header">Want to add a new member?</h2>
                            <button class="settings-section-button" id="new-member-button">Click Me!</button>
                        </div>
                        
                        <!-- change team leader -->
                        <div class="settings-section-card">
                            <h2 class="settings-section-header">Want to change the team leader?</h2>
                            <button class="settings-section-button" id="change-leader-button">Click Me!</button>
                        </div>

                        <!-- delete the project -->
                        <div class="settings-section-card">
                            <h2 class="settings-section-header">Want to delete the project?</h2>
                            <button class="settings-section-button danger-button" id="delete-button">Click Me!</button>
                        </div>
                    <% } %>
                </div>
            </section>
        </section>

        <!-- dialog for leaving -->
        <dialog class="dialog" id="leave-dialog">
            <div class="dialog-inner-container">
                <h1>Are you sure want to leave the project?</h1>
    
                <div class="dialog-buttons">
                    <button class="settings-section-button" id="leave-dialog-no">No</button>
                    <button class="settings-section-button danger-button" id="leave-dialog-yes">Yes</button>
                </div>
            </div>
        </dialog>

        <!-- dialog for adding member -->
        <dialog id="add-dialog">
            <div class="dialog-inner-container">
                <h1>Who would you like to add to the project?</h1>
    
                <input type="text" class="dialog-text-input" id="add-member-input">
    
                <div class="dialog-buttons">
                    <button class="settings-section-button" id="add-dialog-no">Cancel</button>
                    <button class="settings-section-button" id="add-dialog-yes">Add Member</button>
                </div>
            </div>
        </dialog>

        <!-- dialog for changing team leader -->
        <dialog class="dialog" id="team-leader-dialog">
            <div class="dialog-inner-container">
                <h1>Who do you want to make team leader?</h1>
    
                <select class="dialog-select" id="team-leader-select" required>
                    <template class="team-leader-option-template">
                        <option class="team-leader-option"></option>
                    </template>
                </select>
    
                <div class="dialog-buttons">
                    <button class="settings-section-button" id="team-leader-dialog-no">Cancel</button>
                    <button class="settings-section-button" id="team-leader-dialog-yes">Set Team Leader</button>
                </div>
            </div>
        </dialog>

        <!-- dialog for deleting group -->
        <dialog class="dialog" id="delete-dialog">
            <div class="dialog-inner-container">
                <h1>Are you sure want to delete the project?</h1>
    
                <div class="dialog-buttons">
                    <button class="settings-section-button" id="delete-dialog-no">No</button>
                    <button class="settings-section-button danger-button" id="delete-dialog-yes">Yes</button>
                </div>
            </div>
        </dialog>

        <!-- secondary dialog that shows after the first ones -->
        <dialog class="dialog" id="secondary-dialog">
            <div class="dialog-inner-container">
                <h1 id="secondary-dialog-heading"></h1>
                <p id="secondary-dialog-message"></p>
                <button id="secondary-dialog-button">Go To Home</button>
            </div>
        </dialog>

        <%- include('partials/footer') %>
        
        <%- include('partials/loading') %>
    </body>
