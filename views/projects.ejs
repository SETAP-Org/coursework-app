<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <link
            id="theme-stylesheet"
            rel="stylesheet"
            href="/css/root-dark.css"
        />
        <link rel="stylesheet" href="/css/projects.css" />
        <link rel="icon" href="/assets/favicon.png" type="image/png" />

        <script src="/scripts/L&D-mode.js" defer></script>
        <script src="/scripts/projects.js" defer></script>

        <title>Projects</title>
    </head>
    <body>
        <%- include('partials/userNav') %>

        <section id="page-content">
            <section class="page-header">
                <h1 id="page-title"><%= name %>'s Projects</h1>

                <button id="create-project-button">New Project</button>
            </section>
            <section id="projects-list-section">
                <ul class="projects-list"></ul>
            </section>
        </section>

        <template id="project-template">
            <section class="user-dash-project-card-individual">
                <div id="project-info">
                    <b class="project-name"></b>
                    <span class="project-date"></span>
                </div>
                <a href="" class="project-dash-button">Go to project</a>
            </section>
        </template>

        <!-- Popup for creating new project -->
        <dialog id="create-project-dialog">
            <button class="modal-close" onclick="toggleNewProjectForm()">
                X
            </button>
            <form method="dialog">
                <h1>Create Project</h1>
                <label>
                    Project Name
                    <input
                        type="text"
                        placeholder="e.g. My Project"
                        name="project-name"
                        required
                    />
                </label>
                <label>
                    Deadline
                    <input type="date" name="project-deadline" required />
                </label>
                <button type="submit">Create Project</button>
            </form>
        </dialog>

        <%- include('partials/footer') %>
    </body>
</html>
