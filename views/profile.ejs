<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <link id="theme-stylesheet" rel="stylesheet" href="/css/root-dark.css" />
        <link rel="stylesheet" href="/css/profile.css">
        <link rel="icon" href="/assets/favicon.png" type="image/png">

        <script>
            window.scriptData = {
                userFirstName: "<%= userFirstName %>",
                username: "<%= username %>",
                userId: "<%= userId %>",
            };
        </script>
        <script src="/scripts/L&D-mode.js" defer></script>
        <script src="/scripts/profile.js" defer></script>

        <title>GCMS | Profile</title>
    </head>
    <body>
        <%- include('partials/userNav') %>

        <main class="profile-container">
            <div class="profile-container">
                <div class="user-info">
                    <h1>Hey, <%= userFirstName %></h1>
                </div>

                <p><button onclick="changeTheme()">Toggle Theme</button></p>
            </div>
            
            <form action="" class="username-form">
                <input type="text" class="username-input">
                <button class="username-save-button" disabled="true">Save Changes</button>
                <p class="username-message"></p>
            </form>

            <a id="sign-out-button" href="/api/auth/signout">Sign Out</a>
        </main>

        <dialog class="username-dialog">
            <p class="username-dialog-message">You have successfully changed your username, you will now be redirected.</p>
            <button class="username-dialog-button">Go to Home</button>
        </dialog>

        <%- include('partials/footer') %>

        <%- include('partials/loading') %>
    </body>
</html>