<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <link id="theme-stylesheet" rel="stylesheet"/>
        <link rel="stylesheet" href="/css/profile.css">
        <link rel="icon" href="/assets/logo/logo-mark.svg" type="image/svg+xml">

        <script>
            window.scriptData = {
                userFirstName: "<%= userFirstName %>",
                username: "<%= username %>",
                userId: "<%= userId %>",
            };
        </script>
        <script src="/scripts/L&D-mode.js" defer type="module"></script>
        <script src="/scripts/profile.js" defer type="module"></script>

        <title>GCMS | Profile</title>
    </head>
    <body>
        <%- include('partials/userNav') %>

        <main class="profile-container">
            <div class="profile-container">
                <div class="user-info">
                    <div class="profile-avatar-wrap">
                        <img class="profile-avatar" src="/api/me/photo" alt="User Avatar" onerror="this.onerror=null;this.src='/assets/default-avatar.svg';">
                        <button id="change-profile-picture"></button>
                    </div>
                    <h1>Hey, <%= userFirstName %></h1>
                    
                </div>
            </div>


            <div class="username-form-section">
                <h3>Change Username</h3>
                <form action="" class="username-form">
                    <p>New Username</p>
                    <input type="text" class="username-input">
                    <p class="username-message"></p>
                </form>
                <button class="username-save-button" disabled="true">Save Changes</button>
            </div>

            <div class="email-notification-preferences">
                <label for="email-notifications-toggle" class="email-notifications-label">
                    <input 
                        type="checkbox" 
                        id="email-notifications-toggle" 
                        class="email-notifications-toggle"
                    >
                    <span>Receive email notifications</span>
                </label>
                <p class="email-notification-message"></p>
            </div>

            <a id="sign-out-button" href="/api/auth/signout">Sign Out</a>
        </main>

        <dialog class="username-dialog">
            <p class="username-dialog-message">You have successfully changed your username, you will now be redirected.</p>
            <button class="username-dialog-button">Go to Home</button>
        </dialog>

        <%- include('partials/footer') %>

        <%- include('partials/loading') %>
    </body>
</html>